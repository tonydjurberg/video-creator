{
  "name": "ai-commercial-studio-desktop",
  "version": "1.0.0",
  "description": "Windows desktop wrapper for AI Commercial Studio",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tech.tonydjurberg.aicommercialstudio",
    "productName": "AI Commercial Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "app-url.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Commercial-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Commercial Studio"
    }
  }
}
